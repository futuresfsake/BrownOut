# Copy to .env and fill in. Never commit .env.

# Required for live play. Leave empty to run in replay mode only.
ANTHROPIC_API_KEY=

# live   = call the model on every turn (needs the key above)
# replay = play back recorded sessions, no model calls
BROWNOUT_MODE=replay

# Model used for both pipeline steps. See docs/03-design/model-contract.md.
BROWNOUT_MODEL=claude-fable-5-2

# Daily ceiling on model spend in US dollars. Live play switches off for the
# rest of the day when the ceiling is reached.
BROWNOUT_DAILY_BUDGET_USD=5

PORT=3000
