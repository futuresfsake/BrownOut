{
  "name": "brownout",
  "version": "0.0.0",
  "private": true,
  "description": "Crisis war-room simulator: you run the incident, the model plays everyone else.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node tools/install-hooks.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:secrets": "node tools/secrets.mjs tree",
    "check:tracked": "node tools/check-tracked.mjs",
    "check:audit": "node tools/audit.mjs",
    "check:semgrep": "node tools/semgrep.mjs",
    "validate:scenarios": "node tools/validate-scenario.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e2e": "npm run build && playwright test --project=chromium",
    "e2e:evidence": "npm run build && playwright test --project=evidence",
    "e2e:measure": "npm run build && playwright test --project=measure --workers=1",
    "evidence": "node tools/evidence.mjs",
    "play": "tsx src/cli/play.ts",
    "accuracy": "tsx src/tools/accuracy.ts",
    "tools:semgrep": "node tools/install-semgrep.mjs",
    "hooks:install": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  }
}
